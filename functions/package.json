{
  "name": "nflbet-functions",
  "version": "0.1.0",
  "private": true,
  "description": "NFL BET — Cloud Functions (API + scoring + moteurs de bonus)",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:teams": "npm run build && node lib/scripts/seedTeams.js",
    "import:players": "npm run build && node lib/scripts/importPlayers.js",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "typescript": "^5.5.4"
  }
}
